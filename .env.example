# Providers: embeddings = ollama | google | openai ; chat = ollama | google | openai | anthropic
EMBEDDINGS_PROVIDER=ollama
CHAT_PROVIDER=ollama

# --- Ollama (free, local). Run: ollama pull nomic-embed-text && ollama pull llama3.2
# In Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=nomic-embed-text
# CHAT_MODEL=llama3.2

# --- Google Gemini (free tier, key from Google AI Studio)
# GOOGLE_API_KEY=
# --- OpenAI / Anthropic (paid)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional reranking
COHERE_API_KEY=

# Optional tuning (re-upload documents after changing chunk settings)
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=4

# Web search (optional). Provider: tavily | brave | searxng
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SEARXNG_URL=http://localhost:8080
# WEB_RESULTS=4

# Model tuning (optional)
# TEMPERATURE=0.2
# OLLAMA_NUM_CTX=8192
# Bigger local models answer and code much better if your PC has the RAM, e.g.:
#   ollama pull qwen2.5-coder:7b   (code)    ollama pull llama3.1:8b   (general)
# then set CHAT_MODEL=qwen2.5-coder:7b
